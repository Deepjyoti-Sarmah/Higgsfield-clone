#!/usr/bin/env python3
"""Fail on markdown links whose local target does not exist."""
import re
import subprocess
import sys
from pathlib import Path

LINK = re.compile(r"\[[^\]]*\]\(([^)\s]+)(?:\s+\"[^\"]*\")?\)")
SKIP_DIRS = {"node_modules", ".venv", "dist", "generated", ".git", "pixovid", ".agent-logs"}
IGNORED_PREFIXES = ("http://", "https://", "mailto:", "#", "tel:")


def markdown_files():
    listed = subprocess.run(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard"],
        capture_output=True, text=True, check=True).stdout.splitlines()
    paths = [Path(p) for p in listed]
    return [p for p in paths if p.is_file() and p.suffix == ".md" and not SKIP_DIRS & set(p.parts)]


def broken_links(path):
    broken = []
    for raw in LINK.findall(path.read_text(encoding="utf-8", errors="replace")):
        target = raw.split("#")[0]
        if not target or target.startswith(IGNORED_PREFIXES):
            continue
        if not (path.parent / target).resolve().exists():
            broken.append(f"{path}: {raw}")
    return broken


def main():
    broken = [line for path in markdown_files() for line in broken_links(path)]
    for line in broken:
        print(line)
    print(f"check-links: {'FAIL' if broken else 'ok'} ({len(broken)} broken)")
    sys.exit(1 if broken else 0)


if __name__ == "__main__":
    main()
