#!/usr/bin/env python3
"""T-030: build one preview clip per preset with the existing recipes, then upload to S3/R2.

Run from the repo root:  scripts/build-preset-previews --dry-run
                         scripts/build-preset-previews            # uploads to S3_* storage
"""
import argparse
import asyncio
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
API_DIR = ROOT / "apps" / "api"
VENV_PYTHON = API_DIR / ".venv" / "bin" / "python"

if VENV_PYTHON.exists() and Path(sys.executable) != VENV_PYTHON:
    os.execv(str(VENV_PYTHON), [str(VENV_PYTHON), *sys.argv])

sys.path.insert(0, str(API_DIR))

from app.adapters.local_motion_adapter import LocalMotionAdapter  # noqa: E402
from app.adapters.preset_preview_build import (  # noqa: E402
    POSTER_CONTENT_TYPE,
    VIDEO_CONTENT_TYPE,
    build_preview_request,
    preview_paths,
)
from app.domain.preset_catalog import PRESET_CATALOG  # noqa: E402

SOURCES_DIR = API_DIR / "app" / "adapters" / "fixtures" / "preview_sources"
OUTPUT_DIR = ROOT / "build" / "previews"
SOURCE_COUNT = 4


async def build_one(slug: str, source: Path, output_dir: Path) -> tuple[Path, Path]:
    request = build_preview_request(slug, source, output_dir)
    result = await LocalMotionAdapter().generate_video(request)
    return result.video_path, result.poster_path


async def upload(slug: str, video_path: Path, poster_path: Path) -> None:
    from app.adapters.s3_object_storage import S3ObjectStorage
    from app.settings import get_settings

    storage = S3ObjectStorage(get_settings())
    video_key, poster_key = preview_paths(slug)
    await storage.upload_from_path(video_key, video_path, VIDEO_CONTENT_TYPE)
    await storage.upload_from_path(poster_key, poster_path, POSTER_CONTENT_TYPE)
    print(f"uploaded {video_key} + {poster_key}")


async def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="render only, do not upload")
    args = parser.parse_args()

    sources = sorted(SOURCES_DIR.glob("source-*.jpg"))
    if len(sources) < SOURCE_COUNT:
        raise SystemExit(f"expected {SOURCE_COUNT} sources in {SOURCES_DIR}; run make_sources.sh")
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    for index, preset in enumerate(PRESET_CATALOG):
        source = sources[index % SOURCE_COUNT]
        video_path, poster_path = await build_one(preset.slug, source, OUTPUT_DIR)
        size_kb = video_path.stat().st_size // 1024
        print(f"{preset.slug:12s} {video_path.name} {size_kb} KB  (from {source.name})")
        if not args.dry_run:
            await upload(preset.slug, video_path, poster_path)
    print("dry-run: no upload" if args.dry_run else "done: previews uploaded")


if __name__ == "__main__":
    asyncio.run(main())
