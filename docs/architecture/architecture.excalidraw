      "roundness": null,
      "boundElements": [],
      "text": "FastAPI  \u00b7  Pydantic v2  \u00b7  SQLAlchemy 2.0 async  \u00b7  asyncpg     [stateless, N replicas]\nverifies better-auth JWT via JWKS   \u00b7   POST /v1/jobs -> 202   \u00b7   GET /v1/jobs/{id}/events (SSE)\npresign R2 URLs   \u00b7   webhooks: /hooks/stripe   /hooks/provider",
      "rawText": "FastAPI  \u00b7  Pydantic v2  \u00b7  SQLAlchemy 2.0 async  \u00b7  asyncpg     [stateless, N replicas]\nverifies better-auth JWT via JWKS   \u00b7   POST /v1/jobs -> 202   \u00b7   GET /v1/jobs/{id}/events (SSE)\npresign R2 URLs   \u00b7   webhooks: /hooks/stripe   /hooks/provider",
