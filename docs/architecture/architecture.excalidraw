      "roundness": null,
      "boundElements": [],
      "text": "WHERE IT RUNS\nNext.js   -> Vercel or CF Pages\nFastAPI   -> Fly.io / Railway / Render  (containers)\nWorkers   -> same image, different entrypoint\nPostgres  -> Neon / Supabase / RDS\nObjects   -> Cloudflare R2   (MinIO locally)\nEdge      -> Cloudflare in front of all of it\nGPU       -> Runpod / Modal  (only once utilisation > ~45%)",
      "rawText": "WHERE IT RUNS\nNext.js   -> Vercel or CF Pages\nFastAPI   -> Fly.io / Railway / Render  (containers)\nWorkers   -> same image, different entrypoint\nPostgres  -> Neon / Supabase / RDS\nObjects   -> Cloudflare R2   (MinIO locally)\nEdge      -> Cloudflare in front of all of it\nGPU       -> Runpod / Modal  (only once utilisation > ~45%)",
      "fontSize": 15,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r955471870",
      "originalText": "WHERE IT RUNS\nNext.js   -> Vercel or CF Pages\nFastAPI   -> Fly.io / Railway / Render  (containers)\nWorkers   -> same image, different entrypoint\nPostgres  -> Neon / Supabase / RDS\nObjects   -> Cloudflare R2   (MinIO locally)\nEdge      -> Cloudflare in front of all of it\nGPU       -> Runpod / Modal  (only once utilisation > ~45%)",
      "autoResize": true,
