      "index": "a00022",
      "roundness": null,
      "boundElements": [],
      "text": "Postgres   (Neon)        <-- the only stateful service\nuser (is_guest) \u00b7 asset \u00b7 preset \u00b7 payment\njob \u00b7 job_step          <-- THE QUEUE\nledger  (balance = SUM(ledger), never denormalised)\nLISTEN / NOTIFY         <-- THE PUB/SUB  (no Redis)",
      "rawText": "Postgres   (Neon)        <-- the only stateful service\nuser (is_guest) \u00b7 asset \u00b7 preset \u00b7 payment\njob \u00b7 job_step          <-- THE QUEUE\nledger  (balance = SUM(ledger), never denormalised)\nLISTEN / NOTIFY         <-- THE PUB/SUB  (no Redis)",
