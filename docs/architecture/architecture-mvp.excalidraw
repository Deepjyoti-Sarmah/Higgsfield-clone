    {
      "angle": 0,
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "seed": 43242695,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "updated": 1,
      "link": null,
      "locked": false,
      "id": "t970921526",
      "type": "text",
      "x": 894.45,
      "y": 1872.5,
      "width": 331.1,
      "height": 315.0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "index": "a00059",
      "roundness": null,
      "boundElements": [],
      "text": "STILL DO NOT CUT\n\n1. credit HOLD / SETTLE / RELEASE\n   refunds need a live process; holds don't\n\n2. lease + reaper (in the worker loop)\n   survives kill -9 without charging anyone\n\n3. idempotency_key unique index\n\n4. workers as their OWN processes\n\n5. ModelAdapter Protocol\n\n6. job_step as its own table\n\n7. OG share page  <-- the growth loop\n   an SPA alone renders a grey link",
      "rawText": "STILL DO NOT CUT\n\n1. credit HOLD / SETTLE / RELEASE\n   refunds need a live process; holds don't\n\n2. lease + reaper (in the worker loop)\n   survives kill -9 without charging anyone\n\n3. idempotency_key unique index\n\n4. workers as their OWN processes\n\n5. ModelAdapter Protocol\n\n6. job_step as its own table\n\n7. OG share page  <-- the growth loop\n   an SPA alone renders a grey link",
      "fontSize": 14,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r539892633",
      "originalText": "STILL DO NOT CUT\n\n1. credit HOLD / SETTLE / RELEASE\n   refunds need a live process; holds don't\n\n2. lease + reaper (in the worker loop)\n   survives kill -9 without charging anyone\n\n3. idempotency_key unique index\n\n4. workers as their OWN processes\n\n5. ModelAdapter Protocol\n\n6. job_step as its own table\n\n7. OG share page  <-- the growth loop\n   an SPA alone renders a grey link",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
