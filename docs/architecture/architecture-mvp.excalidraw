      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "index": "a00019",
      "roundness": null,
      "boundElements": [],
      "text": "FastAPI  \u00b7  Pydantic v2  \u00b7  SQLAlchemy 2.0 async  \u00b7  asyncpg          [stateless, N replicas]\nAuthlib Google OAuth  +  POST /auth/guest  ->  signed JWT in httpOnly cookie   (no session table)\nPOST /v1/jobs -> 202   (validate \u00b7 moderate \u00b7 HOLD credits \u00b7 insert job+step \u00b7 NOTIFY : ONE txn)\nGET /v1/jobs/{id}/events  ->  SSE      \u00b7      GET /v/{id}  ->  Jinja2 OG page for crawlers\nONE dedicated LISTEN connection per replica  ->  in-process fan-out to asyncio.Queue",
      "rawText": "FastAPI  \u00b7  Pydantic v2  \u00b7  SQLAlchemy 2.0 async  \u00b7  asyncpg          [stateless, N replicas]\nAuthlib Google OAuth  +  POST /auth/guest  ->  signed JWT in httpOnly cookie   (no session table)\nPOST /v1/jobs -> 202   (validate \u00b7 moderate \u00b7 HOLD credits \u00b7 insert job+step \u00b7 NOTIFY : ONE txn)\nGET /v1/jobs/{id}/events  ->  SSE      \u00b7      GET /v/{id}  ->  Jinja2 OG page for crawlers\nONE dedicated LISTEN connection per replica  ->  in-process fan-out to asyncio.Queue",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "r680880884",
      "originalText": "FastAPI  \u00b7  Pydantic v2  \u00b7  SQLAlchemy 2.0 async  \u00b7  asyncpg          [stateless, N replicas]\nAuthlib Google OAuth  +  POST /auth/guest  ->  signed JWT in httpOnly cookie   (no session table)\nPOST /v1/jobs -> 202   (validate \u00b7 moderate \u00b7 HOLD credits \u00b7 insert job+step \u00b7 NOTIFY : ONE txn)\nGET /v1/jobs/{id}/events  ->  SSE      \u00b7      GET /v/{id}  ->  Jinja2 OG page for crawlers\nONE dedicated LISTEN connection per replica  ->  in-process fan-out to asyncio.Queue",
      "autoResize": true,
      "lineHeight": 1.25
    },
