#!/bin/sh
# Fast local gate: repo standards always, app linters only for staged apps.
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1
status=0

scripts/check-standards || status=1

staged=$(git diff --cached --name-only --diff-filter=ACMR)

if printf '%s\n' "$staged" | grep -q '^apps/api/'; then
  uv --directory apps/api run ruff check . || status=1
fi

if printf '%s\n' "$staged" | grep -q '^apps/web/'; then
  npm --prefix apps/web run lint || status=1
fi

if [ "$status" -ne 0 ]; then
  echo "pre-commit: FAILED" >&2
  exit 1
fi

echo "pre-commit: ok"
