# Copy to .env.local for local dev. Names only; never commit values.
ENV=local
APP_ROLE=api
PORT=8000

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/higgsfield
SESSION_SECRET=

S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=3600

GENERATION_BACKEND=modal
IMAGE_GENERATION_BACKEND=placeholder
GENERATION_TIMEOUT_SECONDS=600
MOCK_GENERATION_FAILS=false
MODAL_ENDPOINT_URL=
MODAL_WEBHOOK_SECRET=
OPENROUTER_API_KEY=
PAID_BUDGET_CENTS=500

WORKER_LEASE_SECONDS=300
WORKER_POLL_SECONDS=1.0
WORKER_REAPER_SECONDS=30
STATIC_DIR=../web/dist
